# Porta del server (default: 3000)
PORT=3000

# Segreto per la firma e verifica dei token JWT
TOKEN_SECRET=quicksketch_super_secret_jwt_key_2025_2026

# Configurazione Database PostgreSQL
DIALECT=postgres
# In ambiente Docker Compose l'host del database è 'db'
DB_CONNECTION_URI=postgres://postgres:postgres@db:5432/quicksketch
# Se eseguito fuori da Docker (host locale): postgres://postgres:postgres@localhost:5432/quicksketch
DB_SSL=false
